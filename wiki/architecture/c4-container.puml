@startuml Fidalgo_Container

!theme plain
skinparam backgroundColor #FFFFFF
skinparam rectangle {
    BackgroundColor White
    BorderColor #333333
    ArrowColor #333333
}

title C4 Container Diagram - Fidalgo JobSearch AI

System_Boundary(fidalgo, "Fidalgo JobSearch AI") {

    Container(frontend, "Web UI", "React 19 + TypeScript + Vite", "Job triage table, profile readiness display, application packet generator modal, and inline PDF/Markdown preview & download.")

    Container(web_host, "Web Host API", "C# .NET 10 ASP.NET Core Minimal API", "Serves static SPA, exposes /api/jobs, /api/tenants, /api/profile/defaults, and /api/jobs/{id}/packet endpoints with GlobalExceptionHandler.")

    Container(ingest_cli, "Fidalgo.Ingest", "C# .NET 10 CLI", "Discovers job postings via Adzuna API (ApiModeRunner) or Playwright Firefox scraping (JobSearchAgent). Supports zero-flag config.json execution.")

    Container(agent_cli, "Fidalgo.Agent", "C# .NET 10 CLI", "Evaluates untriaged jobs (JobEvaluationAgent) and generates batch or single-job application packets (AgentRunner).")

    Container(shared_core, "Fidalgo.Shared", "C# .NET 10 Class Library", "Shared JobRepository, UserProfileLoader, ITextGenerator, IPdfRenderer (MdToPdfRenderer), ApplicationPacketService, and FileSystemApplicationPacketStore.")

    ContainerDb(sqlite_db, "SQLite Database", "EF Core (%APPDATA%\\fidalgo\\jobs.db)", "Persistent store for JobEntity postings, AI evaluation scores/hints, and soft-delete flags.")

    ContainerDb(config_store, "User Configuration", "%APPDATA%\\.config\\Fidalgo\\config.json", "Stores default Email, ZipCode, JobSearchKeywords, and ApplicationPacket settings.")

    ContainerDb(user_docs, "User Documents & Packets", "Documents\\Fidalgo\\", "Stores base resume.md, career-story.md, career-goals.md, and generated per-job packets under applications\\<job-folder>\\.")
}

System_Ext(adzuna_and_boards, "Adzuna API & Job Boards", "External job search API and web listings")
System_Ext(local_llm, "Local LLM Server\n(192.168.1.21:8080)", "OpenAI-compatible inference server")
System_Ext(md_to_pdf, "md-to-pdf Service\n(localhost:8000)", "spawnia/md-to-pdf container (WeasyPrint engine)")

Rel(frontend, web_host, "HTTPS / JSON &\nPDF streams")
Rel(web_host, shared_core, "uses repositories,\nprofile & packet services")
Rel(ingest_cli, shared_core, "uses repositories,\nfetch tools & config")
Rel(agent_cli, shared_core, "uses repositories,\nLLM & packet services")

Rel(ingest_cli, adzuna_and_boards, "Adzuna REST API &\nPlaywright Firefox scraping")
Rel(shared_core, sqlite_db, "EF Core reads/writes")
Rel(shared_core, config_store, "reads defaults via\nIConfiguration")
Rel(shared_core, user_docs, "reads profile .md;\nwrites PDFs & job-posting.md")
Rel(shared_core, local_llm, "POST /v1/chat/completions\n(OpenAiTextGenerator)")
Rel(shared_core, md_to_pdf, "POST form-urlencoded\n(MdToPdfRenderer)")

@enduml
