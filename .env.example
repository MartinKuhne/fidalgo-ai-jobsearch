# Copy this file to .env and fill in your secrets and local folder paths.
# .env is gitignored and never committed.

# === API & LLM Secrets ===
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key

LLM_ENDPOINT=http://host.docker.internal:8080/v1
LLM_MODEL=google/gemma-4-e4b
LLM_API_KEY=your-llm-api-key

# Optional (used only when starting --profile scrape)
URL_TO_MARKDOWN_APP_KEY=change-me-local-url-to-markdown-key
SEARXNG_SECRET=change-me-local-searxng-secret

# === Host Port ===
FIDALGO_HOST_PORT=5299
MD_TO_PDF_PORT=8000

# === Mounted Host Directories ===
# Defaults use ./data/* under the repository root.
# On Windows you can point these directly at your existing folders, e.g.:
#   FIDALGO_CONFIG_DIR=C:/Users/<you>/AppData/Roaming/.config/Fidalgo
#   FIDALGO_PROFILE_DIR=C:/Users/<you>/Documents/Fidalgo
#   FIDALGO_APPLICATIONS_DIR=C:/Users/<you>/Documents/Fidalgo/applications
#   FIDALGO_DB_DIR=C:/Users/<you>/AppData/Roaming/fidalgo
#   FIDALGO_LOGS_DIR=C:/Users/<you>/AppData/Roaming/fidalgo/logs
FIDALGO_CONFIG_DIR=./data/config
FIDALGO_PROFILE_DIR=./data/profile
FIDALGO_APPLICATIONS_DIR=./data/applications
FIDALGO_DB_DIR=./data/db
FIDALGO_LOGS_DIR=./data/logs
