@startuml Fidalgo_Deployment

!theme plain
skinparam backgroundColor #FFFFFF
skinparam rectangle {
    BackgroundColor White
    BorderColor #333333
    ArrowColor #333333
}

title C4 Deployment Diagram - Fidalgo JobSearch AI

Deployment_Node(host_machine, "Host Workstation / Docker Compose Stack (.env + Volume Mounts)") {

    Deployment_Node(host_proc, "fidalgo-host Container / .NET 10 Web Process") {
        component [ASP.NET Core Minimal API\n+ React SPA (wwwroot)] as web_server
        component [ApplicationPacketService\n+ GlobalExceptionHandler] as host_packet_svc
    }

    Deployment_Node(cli_procs, "fidalgo-ingest & fidalgo-agent Containers / CLIs") {
        component [ApiModeRunner / JobSearchAgent\n(Playwright Firefox)] as ingest_proc
        component [JobEvaluationAgent &\nAgentRunner] as agent_proc
    }

    node local_storage {
        database "jobs.db & logs\\\n(/data/db, /data/logs or %APPDATA%\\fidalgo\\)" as appdata_state
        file "config.json\n(/data/config or %APPDATA%\\.config\\Fidalgo\\)" as config_file
        folder "Profile & Applications\n(/data/profile, /data/applications or Documents\\Fidalgo\\)" as user_docs
    }
}

Deployment_Node(pdf_container, "spawnia/md-to-pdf Container\n(md-to-pdf:8000 / localhost:8000)") {
    component [WeasyPrint HTTP API\n(POST form-urlencoded)] as md_to_pdf_api
}

Deployment_Node(local_server, "Local LLM Server\n(192.168.1.21:8080)") {
    component [OpenAI-Compatible API\n(e.g., llama.cpp / vLLM)] as llm_api
}

Deployment_Node(ext_sources, "External Job Sources") {
    component [Adzuna REST API &\nJob Boards] as job_boards
}

' === Connections ===
Rel(web_server, host_packet_svc, "in-process DI")
Rel(host_packet_svc, appdata_state, "EF Core SQLite +\nSerilog JSON logs")
Rel(host_packet_svc, config_file, "reads defaults")
Rel(host_packet_svc, user_docs, "reads profile .md;\nwrites packets")

Rel(ingest_proc, job_boards, "REST API / Playwright\nFirefox scraping")
Rel(ingest_proc, appdata_state, "writes jobs.db +\nlogs\\")
Rel(ingest_proc, config_file, "reads defaults")

Rel(agent_proc, appdata_state, "reads/updates jobs.db\n+ logs\\")
Rel(agent_proc, config_file, "reads defaults")
Rel(agent_proc, user_docs, "reads profile .md;\nwrites packets")

Rel(host_packet_svc, llm_api, "HTTP POST\n/v1/chat/completions")
Rel(agent_proc, llm_api, "HTTP POST\n/v1/chat/completions")
Rel(host_packet_svc, md_to_pdf_api, "HTTP POST\n(markdown, css, weasyprint)")
Rel(agent_proc, md_to_pdf_api, "HTTP POST\n(markdown, css, weasyprint)")

@enduml
