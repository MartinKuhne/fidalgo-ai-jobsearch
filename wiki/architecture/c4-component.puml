@startuml Fidalgo_Component

!theme plain
skinparam backgroundColor #FFFFFF
skinparam rectangle {
    BackgroundColor White
    BorderColor #333333
    ArrowColor #333333
}

title C4 Component Diagram - Fidalgo Application Packet Extension

package "CLI Entry Points" #LightBlue {
    component [Fidalgo.Ingest\nProgram / ApiModeRunner] as ingest_runner
    component [Fidalgo.Agent\nProgram / AgentRunner] as agent_runner
    component [JobEvaluationAgent] as eval_agent
}

package "Web Presentation (Fidalgo.Host & Fidalgo.Frontend)" #LightGreen {
    component [React SPA\n(App / ApplicationPacketModal)] as spa
    component [Minimal API Endpoints\n(/api/jobs, /api/profile/defaults,\n/api/jobs/{id}/packet*)] as api
    component [GlobalExceptionHandler\n(ProblemDetails)] as err_handler
    component [JobsService / TenantService] as host_services
}

package "Fidalgo.Shared Core Services" #LightYellow {
    component [UserProfileResolver &\nUserProfileLoader] as profile_loader
    component [ApplicationPacketService] as packet_service
    component [Prompt Builders &\nJobPostingSnapshotBuilder] as prompt_builders
    component [OpenAiTextGenerator\n(ITextGenerator + Polly)] as text_gen
    component [MdToPdfRenderer\n(IPdfRenderer + PdfCssProvider)] as pdf_renderer
    component [FileSystemApplicationPacketStore &\nApplicationPacketPaths] as packet_store
    component [JobRepository / JobDbContext] as job_repo
}

package "Local Filesystem & SQLite" #LightGray {
    database "jobs.db\n(%APPDATA%\\fidalgo)" as sqlite
    folder "config.json\n(%APPDATA%\\.config\\Fidalgo)" as config_dir
    folder "Documents\\Fidalgo\\\n(resume, story, goals,\napplications\\<job>\\)" as docs_dir
}

System_Ext(local_llm, "Local LLM\n192.168.1.21:8080", "OpenAI-compatible API")
System_Ext(md_to_pdf, "spawnia/md-to-pdf\nlocalhost:8000", "WeasyPrint HTTP API")
System_Ext(adzuna, "Adzuna / Job Boards", "External job sources")

spa --> api : JSON & PDF/MD streams
api --> err_handler : maps exceptions\n(400/401/404/502/500)
api --> host_services : queries jobs & tenants
api --> profile_loader : GET /api/profile/defaults
api --> packet_service : POST /api/jobs/{id}/packet
api --> packet_store : GET packet status & files

ingest_runner --> adzuna : fetches job postings
ingest_runner --> job_repo : upserts JobEntity

agent_runner --> eval_agent : evaluates untriaged jobs
agent_runner --> packet_service : batch / target-job\npacket generation
eval_agent --> job_repo : updates Score, Pros,\nCons, ResumeHints
eval_agent --> local_llm : tool-calling evaluation

packet_service --> job_repo : reads JobEntity\n(checks IsDeleted)
packet_service --> profile_loader : loads resume, story, goals
packet_service --> prompt_builders : builds prompts &\njob-posting.md
packet_service --> text_gen : tailored resume &\ncover letter Markdown
packet_service --> pdf_renderer : renders resume.pdf &\ncover-letter.pdf
packet_service --> packet_store : atomic staging save

host_services --> job_repo : reads/soft-deletes jobs
job_repo --> sqlite : EF Core SQLite
profile_loader --> config_dir : legacy fallback &\nconfig defaults
profile_loader --> docs_dir : reads profile .md
packet_store --> docs_dir : reads/writes\napplications\\<job>\\

text_gen --> local_llm : HTTP POST + Polly retry
pdf_renderer --> md_to_pdf : HTTP POST (markdown,\ncss, engine=weasyprint)

@enduml
